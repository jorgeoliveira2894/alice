{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "galeria": {
      "root": ".",
      "framework": "vite"
    },
    "aprovacoes": {
      "root": "leblon-aprovacoes",
      "framework": "vite",
      "buildCommand": "BASE_PATH=/aprovacoes/ npm run build",
      "rewrites": [
        { "source": "/aprovacoes", "destination": "/aprovacoes/index.html" },
        { "source": "/aprovacoes/(.*)", "destination": "/aprovacoes/index.html" }
      ]
    }
  },
  "rewrites": [
    { "source": "/aprovacoes", "destination": { "service": "aprovacoes" } },
    { "source": "/aprovacoes/(.*)", "destination": { "service": "aprovacoes" } },
    { "source": "/(.*)", "destination": { "service": "galeria" } }
  ]
}
